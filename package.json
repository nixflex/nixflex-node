{
  "name": "nixflex",
  "version": "0.2.2",
  "description": "Official Node.js SDK for the Nixflex voice AI platform - AI phone agents, outbound campaigns, and SMS.",
  "keywords": [
    "nixflex",
    "voice-ai",
    "voice-agent",
    "phone",
    "telephony",
    "ai-receptionist",
    "twilio",
    "telnyx",
    "sms",
    "speech",
    "api-client",
    "sdk"
  ],
  "homepage": "https://github.com/nixflex/nixflex-node#readme",
  "bugs": {
    "url": "https://github.com/nixflex/nixflex-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nixflex/nixflex-node.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check": "node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build && npm run check"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "author": "Nixflex"
}
